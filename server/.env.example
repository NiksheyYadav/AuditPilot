# --- Server ---
PORT=4000
# Leave MONGO_URI empty to use an in-memory demo DB (resets on restart).
# Atlas example: mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/auditpilot
MONGO_URI=
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173

# DEV/DEMO ONLY: allows auditing localhost so the built-in /demo pages work. Turn OFF in production.
ALLOW_PRIVATE_TARGETS=true
AUDIT_RATE_LIMIT=20
CHAT_RATE_LIMIT=30

# --- Local open-source LLM via Ollama (no cloud keys) ---
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:3b
# Alternatives that support tool calling: llama3.2:3b (small), qwen2.5:7b or llama3.1:8b (need ~8 GB free RAM)
LLM_TIMEOUT_MS=120000
# LLM_PROVIDER=mock   # deterministic scripted fallback, shown in the UI as MOCK LLM
